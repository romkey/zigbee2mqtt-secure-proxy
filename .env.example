# Every environment variable this project uses, with dummy values. Copy to
# .env (gitignored) and fill in real values there; never in this file.
# docs/configuration.md says what each one does.

# --- The app ---------------------------------------------------------------

# Address to listen on. The Docker image sets 0.0.0.0; natively the
# default, 127.0.0.1, keeps the app private to this machine.
# HOST=127.0.0.1

# Port to listen on.
PORT=8080

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# PostgreSQL connection. The host is "db" under docker-compose.prod.yaml.
DATABASE_URL=postgresql://proxy:REPLACE_ME@db:5432/proxy

# The MQTT broker zigbee2mqtt uses: mqtt://host:1883 or mqtts://host:8883.
MQTT_URL=mqtt://mosquitto:1883

# Broker credentials, if it needs them.
# MQTT_USERNAME=proxy
# MQTT_PASSWORD=REPLACE_ME

# zigbee2mqtt's base_topic.
# MQTT_BASE_TOPIC=zigbee2mqtt

# Seconds to wait for zigbee2mqtt to answer a request.
# MQTT_REQUEST_TIMEOUT=10

# Serve zigbee2mqtt's own web UI through the proxy, from this address.
# FRONTEND_URL=http://zigbee2mqtt:8080

# The OpenID Connect issuer: in Authentik, the provider's "OpenID Configuration
# Issuer" URL.
OIDC_ISSUER=https://auth.example.com/application/o/zigbee2mqtt-proxy/
OIDC_CLIENT_ID=REPLACE_ME
OIDC_CLIENT_SECRET=REPLACE_ME

# Only let members of this group log in. Without it, anyone the provider lets
# through becomes an admin.
# OIDC_REQUIRED_GROUP=zigbee2mqtt-admins

# The address people use to reach the proxy; the login callback is built from it.
PUBLIC_URL=https://zigbee2mqtt-proxy.example.com

# Signs the admin login cookie. At least 32 characters: openssl rand -base64 48
SESSION_SECRET=REPLACE_ME_WITH_AT_LEAST_32_CHARACTERS

# How long a held action can wait for review: 90s, 30m, 24h or 7d.
# REVIEW_TTL=24h

# Actions from one key less than this many seconds apart share a batch.
# ACTION_BATCH_GAP=5

# Days to keep the action log.
# ACTION_RETENTION_DAYS=90

# --- The db service in docker-compose.prod.yaml (not read by the app) -------
# These must agree with DATABASE_URL.
POSTGRES_USER=proxy
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=proxy

# --- Publishing to PyPI (optional; not read by the app) --------------------
# Only for publishing by hand from your machine (`uv publish`); releases
# from GitHub use trusted publishing or the PYPI_API_TOKEN repository
# secret instead; see
# https://github.com/romkey/python-ai-rules/blob/main/docs/releasing.md
# A project-scoped API token from https://pypi.org/manage/account/token/. Keep it out of
# .env on servers: compose passes .env to the app.
# UV_PUBLISH_TOKEN=pypi-REPLACE_ME
